<%- include('../layout') %>

<div style="display:flex; min-height:calc(100vh - 60px);">
  <!-- Sidebar -->
  <nav style="width:220px; flex-shrink:0; background:#fff; border-right:1px solid #EAECEF; padding:20px 0; display:flex; flex-direction:column;">
    <div style="padding:16px 20px; border-bottom:1px solid #EAECEF; margin-bottom:10px;">
      <p style="font-size:0.75rem; color:#9CA3AF; text-transform:uppercase; letter-spacing:1.5px; font-weight:600; margin:0;">Console Admin</p>
    </div>
    
    <a href="/dashboard/admin" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:700; color:#2C2C2C; border-left:3px solid #FFCD00; background:#FFFBEB; text-decoration:none;">
      <span>⚙️</span>Console principale
    </a>
    <a href="/admin/users" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>👤</span>Utilisateurs
    </a>
    <a href="/admin/organisations" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>🏢</span>Organisations
    </a>
    <a href="/admin/recruteurs" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>👥</span>Recruteurs
    </a>
    <a href="/admin/demandes-recruteurs" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>📬</span>Demandes recruteurs
    </a>
    <a href="/admin/offres" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>📋</span>Offres
    </a>
    
    <div style="margin-top:auto; padding:16px 20px; border-top:1px solid #EAECEF;">
      <a href="/auth/logout" style="display:block; padding:10px 14px; background:transparent; color:#9F1239; border:1.5px solid #FFF1F2; border-radius:8px; font-size:0.8rem; font-weight:600; cursor:pointer; text-align:center; text-decoration:none; transition:all 0.15s;"
         onmouseover="this.style.background='#FFF1F2';"
         onmouseout="this.style.background='transparent';">
        🚪 Déconnexion
      </a>
    </div>
  </nav>

  <!-- Main -->
  <main style="flex:1; padding:30px; overflow-y:auto; background:#F8F9FA;">
    <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin-bottom:30px;">
      ⚙️ Console Admin
    </h1>

    <!-- Stats -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-bottom:32px;">
      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #3B82F6;">
        <div style="font-size:2.2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.utilisateurs %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Utilisateurs
        </div>
      </div>

      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #8B5CF6;">
        <div style="font-size:2.2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.candidats %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Candidats
        </div>
      </div>

      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #EC4899;">
        <div style="font-size:2.2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.recruteurs %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Recruteurs
        </div>
      </div>

      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #FFCD00;">
        <div style="font-size:2.2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.offres %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Offres d'emploi
        </div>
      </div>

      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #10B981;">
        <div style="font-size:2.2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.candidatures %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Candidatures
        </div>
      </div>

      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #F59E0B;">
        <div style="font-size:2.2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.organisations %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Organisations
        </div>
      </div>
    </div>

    <!-- Quick access -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px; margin-bottom:32px;">
      <a href="/admin/users" style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:24px; text-decoration:none; transition:all 0.2s; display:block;"
         onmouseover="this.style.boxShadow='0 8px 20px rgba(0,0,0,0.10)'; this.style.transform='translateY(-2px)';"
         onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)'; this.style.transform='translateY(0)';">
        <div style="font-size:2rem; margin-bottom:12px;">👤</div>
        <h3 style="font-size:1rem; font-weight:800; color:#2C2C2C; margin:0 0 6px;">Gérer les utilisateurs</h3>
        <p style="font-size:0.82rem; color:#6B7280; margin:0;">Activation, suppression, modification</p>
      </a>

      <a href="/admin/organisations" style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:24px; text-decoration:none; transition:all 0.2s; display:block;"
         onmouseover="this.style.boxShadow='0 8px 20px rgba(0,0,0,0.10)'; this.style.transform='translateY(-2px)';"
         onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)'; this.style.transform='translateY(0)';">
        <div style="font-size:2rem; margin-bottom:12px;">🏢</div>
        <h3 style="font-size:1rem; font-weight:800; color:#2C2C2C; margin:0 0 6px;">Organisations</h3>
        <p style="font-size:0.82rem; color:#6B7280; margin:0;">Gestion des entreprises enregistrées</p>
      </a>

      <a href="/admin/recruteurs" style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:24px; text-decoration:none; transition:all 0.2s; display:block;"
         onmouseover="this.style.boxShadow='0 8px 20px rgba(0,0,0,0.10)'; this.style.transform='translateY(-2px)';"
         onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)'; this.style.transform='translateY(0)';">
        <div style="font-size:2rem; margin-bottom:12px;">👥</div>
        <h3 style="font-size:1rem; font-weight:800; color:#2C2C2C; margin:0 0 6px;">Recruteurs</h3>
        <p style="font-size:0.82rem; color:#6B7280; margin:0;">Validation des comptes recruteurs</p>
      </a>

      <a href="/admin/demandes-recruteurs" style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:24px; text-decoration:none; transition:all 0.2s; display:block;"
         onmouseover="this.style.boxShadow='0 8px 20px rgba(0,0,0,0.10)'; this.style.transform='translateY(-2px)';"
         onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)'; this.style.transform='translateY(0)';">
        <div style="font-size:2rem; margin-bottom:12px;">📬</div>
        <h3 style="font-size:1rem; font-weight:800; color:#2C2C2C; margin:0 0 6px;">Demandes recruteurs</h3>
        <p style="font-size:0.82rem; color:#6B7280; margin:0;">Accéder directement aux demandes en attente</p>
      </a>

      <a href="/admin/offres" style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:24px; text-decoration:none; transition:all 0.2s; display:block;"
         onmouseover="this.style.boxShadow='0 8px 20px rgba(0,0,0,0.10)'; this.style.transform='translateY(-2px)';"
         onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)'; this.style.transform='translateY(0)';">
        <div style="font-size:2rem; margin-bottom:12px;">📋</div>
        <h3 style="font-size:1rem; font-weight:800; color:#2C2C2C; margin:0 0 6px;">Offres d'emploi</h3>
        <p style="font-size:0.82rem; color:#6B7280; margin:0;">Modération et suppression des offres</p>
      </a>
    </div>

    <!-- Recent activities -->
    <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; box-shadow:0 2px 8px rgba(0,0,0,0.04); padding:22px;">
      <h2 style="font-size:1.1rem; font-weight:800; color:#2C2C2C; margin-bottom:16px;">
        📊 Activité récente
      </h2>
      <p style="font-size:0.85rem; color:#6B7280; margin-bottom:16px;">
        Derniers utilisateurs inscrits, offres publiées et candidatures
      </p>
      <div style="display:grid; gap:8px;">
        <p style="font-size:0.8rem; color:#9CA3AF; padding:8px 0; border-bottom:1px solid #F3F4F6;">
          ✅ <%= stats.utilisateurs %> utilisateurs actifs
        </p>
        <p style="font-size:0.8rem; color:#9CA3AF; padding:8px 0; border-bottom:1px solid #F3F4F6;">
          📋 <%= stats.offres %> offres en ligne
        </p>
        <p style="font-size:0.8rem; color:#9CA3AF; padding:8px 0;">
          👥 <%= stats.candidatures %> candidatures en cours
        </p>
      </div>
    </div>
  </main>
</div>

</body>
</html>
