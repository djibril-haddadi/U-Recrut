<%- include('../layout') %>

<div style="display:flex; min-height:calc(100vh - 60px);">
  <!-- Sidebar -->
  <nav style="width:220px; flex-shrink:0; background:#fff; border-right:1px solid #EAECEF; padding:20px 0; display:flex; flex-direction:column;">
    <div style="padding:16px 20px; border-bottom:1px solid #EAECEF; margin-bottom:10px;">
      <p style="font-size:0.75rem; color:#9CA3AF; text-transform:uppercase; letter-spacing:1.5px; font-weight:600; margin:0;">Dashboard Candidat</p>
    </div>
    
    <a href="/dashboard/candidat" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:700; color:#2C2C2C; border-left:3px solid #FFCD00; background:#FFFBEB; text-decoration:none;">
      <span>📊</span>Tableau de bord
    </a>
    <a href="/candidatures" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>📋</span>Mes candidatures
    </a>
    
    <div style="margin-top:auto; padding:16px 20px; border-top:1px solid #EAECEF;">
      <a href="/auth/logout" style="display:block; padding:10px 14px; background:transparent; color:#9F1239; border:1.5px solid #FFF1F2; border-radius:8px; font-size:0.8rem; font-weight:600; cursor:pointer; text-align:center; text-decoration:none; transition:all 0.15s;"
         onmouseover="this.style.background='#FFF1F2';"
         onmouseout="this.style.background='transparent';">
        🚪 Déconnexion
      </a>
    </div>
  </nav>

  <!-- Main -->
  <main style="flex:1; padding:30px; overflow-y:auto; background:#F8F9FA;">
    <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin-bottom:30px;">
      Bienvenue dans votre tableau de bord
    </h1>

    <!-- Stats -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:32px;">
      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #FFCD00;">
        <div style="font-size:2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.total %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Candidatures totales
        </div>
      </div>

      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #F59E0B;">
        <div style="font-size:2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.enAttente %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          En attente
        </div>
      </div>

      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #3B82F6;">
        <div style="font-size:2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.enEntretien %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Entretiens
        </div>
      </div>

      <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; padding:20px 22px; box-shadow:0 2px 8px rgba(0,0,0,0.04); border-left:4px solid #10B981;">
        <div style="font-size:2rem; font-weight:900; color:#2C2C2C; font-family:'Outfit';">
          <%= stats.acceptees %>
        </div>
        <div style="font-size:0.76rem; font-weight:600; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px; margin-top:4px;">
          Acceptées
        </div>
      </div>
    </div>

    <!-- Offres récentes -->
    <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; box-shadow:0 2px 8px rgba(0,0,0,0.04); padding:22px;">
      <h2 style="font-size:1.1rem; font-weight:800; color:#2C2C2C; margin-bottom:16px;">
        📋 Dernières offres disponibles
      </h2>
      <div style="max-height:400px; overflow-y:auto;">
        <% dernieres.forEach(offre => { %>
          <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid #F3F4F6; cursor:pointer; transition:background 0.12s;"
               onmouseover="this.style.background='#FFFBEB';"
               onmouseout="this.style.background='transparent';">
            <div>
              <p style="font-size:0.9rem; font-weight:700; color:#2C2C2C; margin:0 0 4px;">
                Offre #<%= offre.idOffre %>
              </p>
              <p style="font-size:0.75rem; color:#9CA3AF; margin:0;">
                Publiée le <%= new Date(offre.datePublication).toLocaleDateString('fr-FR') %>
              </p>
            </div>
            <a href="/offres/<%= offre.idOffre %>" style="display:inline-block; padding:6px 12px; background:#FFCD00; color:#2C2C2C; text-decoration:none; border-radius:6px; font-size:0.75rem; font-weight:700; cursor:pointer; transition:all 0.18s;"
               onmouseover="this.style.background='#F5C200';"
               onmouseout="this.style.background='#FFCD00';">
              Voir offre
            </a>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- CTA -->
    <div style="margin-top:24px; background:linear-gradient(135deg, #2C2C2C 0%, #4D4D4D 100%); border-radius:12px; padding:32px; color:#fff; text-align:center;">
      <h3 style="font-size:1.3rem; font-weight:900; color:#fff; margin-bottom:12px;">
        À la recherche de nouvelles opportunités ?
      </h3>
      <p style="color:rgba(255,255,255,0.7); margin-bottom:20px;">
        Consultez toutes les offres d'emploi disponibles et trouvez celle qui vous correspond.
      </p>
      <a href="/offres" style="display:inline-block; padding:12px 28px; background:#FFCD00; color:#2C2C2C; text-decoration:none; border-radius:10px; font-weight:800; cursor:pointer; transition:all 0.18s;"
         onmouseover="this.style.background='#F5C200'; this.style.transform='translateY(-1px)'; this.style.boxShadow='0 4px 16px rgba(255,205,0,0.45)';"
         onmouseout="this.style.background='#FFCD00'; this.style.transform='translateY(0)'; this.style.boxShadow='none';">
        Découvrir les offres →
      </a>
    </div>
  </main>
</div>

</body>
</html>
