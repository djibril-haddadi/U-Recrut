<%- include('layout') %>

<!-- Hero Section -->
<div style="background: linear-gradient(135deg, #2C2C2C 0%, #4D4D4D 55%, #5A5A5A 100%); padding:64px 40px 72px; position:relative; overflow:hidden;">
  <div style="position:absolute; top:-60px; right:-60px; width:320px; height:320px; border-radius:50%; border:70px solid rgba(255,205,0,0.07);"></div>
  <div style="position:absolute; bottom:-80px; left:10%; width:200px; height:200px; border-radius:50%; background:rgba(255,205,0,0.05);"></div>
  
  <div style="max-width:900px;margin:0 auto;position:relative">
    <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,205,0,0.15); border:1px solid rgba(255,205,0,0.3); color:#FFCD00; padding:5px 14px; border-radius:99px; font-size:0.76rem; font-weight:600; text-transform:uppercase; letter-spacing:1px; margin-bottom:18px;">
      ⚡ +<%= offres.length %> offres disponibles
    </div>
    <h1 style="font-size:2.6rem; font-weight:900; color:#fff; line-height:1.15; margin-bottom:12px;">
      Trouvez votre prochaine<br><span style="color:#FFCD00;">opportunité de carrière</span>
    </h1>
    <p style="color:rgba(255,255,255,0.65); font-size:1rem; font-weight:300; margin-bottom:36px;">
      Des milliers d'offres dans les meilleures organisations françaises vous attendent.
    </p>
    
    <form action="/offres" method="GET" style="display:flex; align-items:center; background:#fff; border-radius:14px; max-width:700px; padding:6px 6px 6px 18px; gap:10px; box-shadow:0 8px 30px rgba(0,0,0,0.2);">
      <svg width="18" height="18" fill="none" stroke="#9CA3AF" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input type="text" name="search" placeholder="Intitulé, compétence, entreprise…" style="flex:1; border:none; outline:none; font-family:'Outfit'; font-size:0.94rem; color:#2C2C2C; background:transparent;">
      <div style="width:1px; height:26px; background:#EAECEF;"></div>
      <button type="submit" style="background:#FFCD00; color:#2C2C2C; border:none; padding:11px 26px; border-radius:10px; font-family:'Outfit'; font-weight:700; font-size:0.9rem; cursor:pointer; transition:all 0.18s; white-space:nowrap;"
              onmouseover="this.style.background='#F5C200'; this.style.transform='translateY(-1px)'; this.style.boxShadow='0 4px 16px rgba(255,205,0,0.45)';"
              onmouseout="this.style.background='#FFCD00'; this.style.transform='translateY(0)'; this.style.boxShadow='none';">
        🔍 Rechercher
      </button>
    </form>

    <!-- Stats -->
    <div style="display:flex;gap:32px;margin-top:30px;position:relative">
      <div style="text-align:center"><div style="font-size:1.4rem;font-weight:900;color:#FFCD00"><%= offres.length %>+</div><div style="font-size:0.75rem;color:rgba(255,255,255,0.55);text-transform:uppercase;letter-spacing:0.6px">Offres actives</div></div>
      <div style="text-align:center"><div style="font-size:1.4rem;font-weight:900;color:#FFCD00">500+</div><div style="font-size:0.75rem;color:rgba(255,255,255,0.55);text-transform:uppercase;letter-spacing:0.6px">Entreprises</div></div>
      <div style="text-align:center"><div style="font-size:1.4rem;font-weight:900;color:#FFCD00">10K+</div><div style="font-size:0.75rem;color:rgba(255,255,255,0.55);text-transform:uppercase;letter-spacing:0.6px">Candidats inscrits</div></div>
    </div>
  </div>
</div>

<!-- Offres Grid -->
<div style="max-width:1300px;margin:0 auto;padding:32px 24px;">
  <h2 style="font-size:1.8rem; font-weight:900; color:#2C2C2C; margin-bottom:24px;">Offres récentes</h2>
  
  <% if (offres.length === 0) { %>
    <div style="background:#fff; border-radius:12px; border:1px dashed #EAECEF; padding:40px; text-align:center;">
      <p style="color:#9CA3AF; font-size:1rem;">Aucune offre disponible pour le moment</p>
    </div>
  <% } else { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:16px">
      <% offres.forEach(offre => { %>
        <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; box-shadow:0 2px 12px rgba(0,0,0,0.05); transition:all 0.2s; cursor:pointer; padding:20px;" 
             onmouseover="this.style.boxShadow='0 8px 28px rgba(0,0,0,0.10)'; this.style.transform='translateY(-2px)'; this.style.borderColor='#FFE57A';"
             onmouseout="this.style.boxShadow='0 2px 12px rgba(0,0,0,0.05)'; this.style.transform='translateY(0)'; this.style.borderColor='#EAECEF';">
          
          <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:14px;">
            <div>
              <h3 style="font-size:1rem; font-weight:700; color:#2C2C2C; margin-bottom:6px;">
                <%= offre.fiche?.intitule || 'Offre' %>
              </h3>
              <p style="font-size:0.82rem; color:#6B7280; margin-bottom:10px;">
                <% if (offre.organisation) { %>
                  📍 <%= offre.organisation.nom %>
                <% } %>
              </p>
            </div>
            <% if (offre.fiche?.typeMetier) { %>
              <span style="font-size:0.73rem; font-weight:600; padding:3px 10px; border-radius:99px; background:#FFFBEB; color:#D4A800;">
                <%= offre.fiche.typeMetier %>
              </span>
            <% } %>
          </div>

          <p style="font-size:0.84rem; color:#4D4D4D; margin-bottom:12px; line-height:1.5;">
            <%= offre.fiche?.lieuMission || 'Localisation non spécifiée' %>
          </p>

          <div style="margin-bottom:12px;">
            <% if (offre.fiche?.fourchetteSalaire) { %>
              <span style="font-size:0.76rem; font-weight:700; color:#065F46; background:#ECFDF5; padding:4px 8px; border-radius:6px;">
                💰 <%= offre.fiche.fourchetteSalaire %>
              </span>
            <% } %>
          </div>

          <a href="/offres/<%= offre.idOffre %>" style="display:inline-block; padding:8px 14px; background:#FFCD00; color:#2C2C2C; text-decoration:none; border-radius:8px; font-size:0.8rem; font-weight:700; cursor:pointer; transition:all 0.18s; border:none;"
             onmouseover="this.style.background='#F5C200';"
             onmouseout="this.style.background='#FFCD00';">
            Voir détail →
          </a>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

</body>
</html>
