<%- include('../layout') %>

<div style="display:flex; min-height:calc(100vh - 60px);">
  <!-- Sidebar -->
  <nav style="width:220px; flex-shrink:0; background:#fff; border-right:1px solid #EAECEF; padding:20px 0; display:flex; flex-direction:column;">
    <div style="padding:16px 20px; border-bottom:1px solid #EAECEF; margin-bottom:10px;">
      <p style="font-size:0.75rem; color:#9CA3AF; text-transform:uppercase; letter-spacing:1.5px; font-weight:600; margin:0;">Console Admin</p>
    </div>
    
    <a href="/dashboard/admin" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>⚙️</span>Console principale
    </a>
    <a href="/admin/users" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>👤</span>Utilisateurs
    </a>
    <a href="/admin/organisations" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>🏢</span>Organisations
    </a>
    <a href="/admin/recruteurs" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>👥</span>Recruteurs
    </a>
+    <a href="/admin/demandes-recruteurs" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:700; color:#2C2C2C; border-left:3px solid #FFCD00; background:#FFFBEB; text-decoration:none;">
+      <span>📬</span>Demandes recruteurs
+    </a>
    <a href="/admin/offres" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>📋</span>Offres
    </a>
    
    <div style="margin-top:auto; padding:16px 20px; border-top:1px solid #EAECEF;">
      <a href="/auth/logout" style="display:block; padding:10px 14px; background:transparent; color:#9F1239; border:1.5px solid #FFF1F2; border-radius:8px; font-size:0.8rem; font-weight:600; cursor:pointer; text-align:center; text-decoration:none; transition:all 0.15s;"
         onmouseover="this.style.background='#FFF1F2';"
         onmouseout="this.style.background='transparent';">
        🚪 Déconnexion
      </a>
    </div>
  </nav>

  <!-- Main -->
  <main style="flex:1; padding:30px; overflow-y:auto; background:#F8F9FA;">
    <a href="/dashboard/admin" style="color:#FFCD00; text-decoration:none; font-weight:700; margin-bottom:20px; display:inline-block;">
      ← Retour à la console
    </a>

    <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin-bottom:24px;">
      📬 Demandes de création recruteur
    </h1>

  <% if (demandes.length === 0) { %>
    <div style="background:#fff; border-radius:12px; border:1px dashed #EAECEF; padding:60px 40px; text-align:center;">
      <p style="color:#9CA3AF; font-size:1rem;">Aucune demande en attente</p>
    </div>
  <% } else { %>
    <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.05);">
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr style="border-bottom:2px solid #EAECEF; background:#F8F9FA;">
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">ID</th>
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">Demandeur</th>
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">Organisation (SIREN)</th>
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">Date</th>
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">Statut</th>
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% demandes.forEach(d => { %>
            <tr style="border-bottom:1px solid #F3F4F6;" onmouseover="this.style.background='#FFFBEB';" onmouseout="this.style.background='transparent';">
              <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;"><%= d.idDemandeRecruteur %></td>
              <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;"><strong><%= d.user?.prenom %> <%= d.user?.nom %></strong><br/><span style="color:#6B7280;"><%= d.user?.email %></span></td>
              <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;"><%= d.organisation ? d.organisation.nom + ' (' + d.sirenOrganisation + ')' : d.sirenOrganisation %></td>
              <td style="padding:16px; font-size:0.85rem; color:#6B7280;"><%= d.dateDemande ? d.dateDemande.toString().slice(0,10) : '' %></td>
              <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;"><%= d.statutDemande %></td>
              <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;">
                <% if (d.statutDemande === 'en_attente') { %>
                  <form method="post" action="/admin/demandes-recruteurs/<%= d.idDemandeRecruteur %>/accept" style="display:inline-block; margin-right:8px;">
                    <button style="padding:8px 10px; background:#10B981; color:#fff; border-radius:8px; border:none; cursor:pointer;">Accepter</button>
                  </form>
                  <form method="post" action="/admin/demandes-recruteurs/<%= d.idDemandeRecruteur %>/reject" style="display:inline-block;">
                    <button style="padding:8px 10px; background:#EF4444; color:#fff; border-radius:8px; border:none; cursor:pointer;">Refuser</button>
                  </form>
                <% } else { %>
                  <span style="color:#9CA3AF;"><%= d.statutDemande %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main></div>

</body>
</html>
