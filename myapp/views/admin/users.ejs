<%- include('../layout') %>

<div style="max-width:1400px;margin:0 auto;padding:32px 24px;">
  <a href="/dashboard/admin" style="color:#FFCD00; text-decoration:none; font-weight:700; margin-bottom:20px; display:inline-block;">
    ← Retour à la console
  </a>

  <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin-bottom:24px;">
    👤 Gestion des utilisateurs
  </h1>

  <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.05);">
    <table style="width:100%; border-collapse:collapse;">
      <thead>
        <tr style="border-bottom:2px solid #EAECEF; background:#F8F9FA;">
          <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px;">ID</th>
          <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px;">Nom</th>
          <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px;">Email</th>
          <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px;">Status</th>
          <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px;">Inscrit le</th>
          <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:0.6px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr style="border-bottom:1px solid #F3F4F6; transition:background 0.12s;"
              onmouseover="this.style.background='#FFFBEB';"
              onmouseout="this.style.background='transparent';">
            <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;"><%= user.idUtilisateur %></td>
            <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;">
              <strong><%= user.prenom %> <%= user.nom %></strong>
            </td>
            <td style="padding:16px; font-size:0.85rem; color:#6B7280;"><%= user.email %></td>
            <td style="padding:16px; font-size:0.85rem;">
              <span style="display:inline-flex; align-items:center; gap:4px; padding:4px 10px; border-radius:99px; font-size:0.7rem; font-weight:700;
                background:<%= user.statutCompte === 'actif' ? 'rgba(16, 185, 129, 0.15); color:#065F46;' : 'rgba(239, 68, 68, 0.15); color:#991B1B;' %>">
                <%= user.statutCompte === 'actif' ? '✅ Actif' : '❌ Inactif' %>
              </span>
            </td>
            <td style="padding:16px; font-size:0.85rem; color:#6B7280;">
              <%= new Date(user.dateCreation).toLocaleDateString('fr-FR') %>
            </td>
            <td style="padding:16px; font-size:0.85rem;">
              <button onclick="desactiverUtilisateur(<%= user.idUtilisateur %>)" style="padding:5px 10px; background:rgba(245, 158, 11, 0.15); border:1px solid #F59E0B; color:#92400E; border-radius:6px; font-size:0.7rem; font-weight:600; cursor:pointer; transition:all 0.15s; font-family:'Outfit';"
                      onmouseover="this.style.background='rgba(245, 158, 11, 0.25)';"
                      onmouseout="this.style.background='rgba(245, 158, 11, 0.15)';">
                🔒 Désactiver
              </button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<script>
function desactiverUtilisateur(id) {
  if (!confirm('Êtes-vous sûr de vouloir désactiver ce compte ?')) return;
  
  fetch('/admin/users/' + id + '/deactivate', { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        alert('✅ Compte désactivé');
        window.location.reload();
      } else {
        alert('❌ Erreur');
      }
    });
}
</script>

</body>
</html>
