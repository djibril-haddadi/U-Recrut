<%- include('../layout') %>

<div style="max-width:1400px;margin:0 auto;padding:32px 24px;">
  <a href="/dashboard/admin" style="color:#FFCD00; text-decoration:none; font-weight:700; margin-bottom:20px; display:inline-block;">
    ← Retour à la console
  </a>

  <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin-bottom:24px;">
    👥 Recruteurs
  </h1>

  <% if (recruteurs.length === 0) { %>
    <div style="background:#fff; border-radius:12px; border:1px dashed #EAECEF; padding:60px 40px; text-align:center;">
      <p style="color:#9CA3AF; font-size:1rem;">Aucun recruteur enregistré</p>
    </div>
  <% } else { %>
    <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.05);">
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr style="border-bottom:2px solid #EAECEF; background:#F8F9FA;">
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">ID</th>
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">Recruteur</th>
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">Email</th>
            <th style="padding:16px; text-align:left; font-size:0.72rem; font-weight:700; color:#9CA3AF; text-transform:uppercase;">Organisation</th>
          </tr>
        </thead>
        <tbody>
          <% recruteurs.forEach(rec => { %>
            <tr style="border-bottom:1px solid #F3F4F6;"
                onmouseover="this.style.background='#FFFBEB';"
                onmouseout="this.style.background='transparent';">
              <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;"><%= rec.idRecruteur %></td>
              <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;">
                <strong><%= rec.user?.prenom %> <%= rec.user?.nom %></strong>
              </td>
              <td style="padding:16px; font-size:0.85rem; color:#6B7280;"><%= rec.user?.email %></td>
              <td style="padding:16px; font-size:0.85rem; color:#4D4D4D;">
                <% if (rec.organisation) { %>
                  <span style="padding:4px 10px; background:#FFFBEB; border-radius:6px; font-size:0.75rem;">
                    <%= rec.organisation.nom %>
                  </span>
                <% } else { %>
                  <span style="color:#9CA3AF;">Non assignée</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

</body>
</html>
