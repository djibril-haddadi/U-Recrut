<%- include('layout') %>

<div style="max-width:600px;margin:60px auto;padding:24px;text-align:center;">
  <h1 style="font-size:3rem;font-weight:900;color:#2C2C2C;margin-bottom:12px;">
    <%= error?.status || '500' %>
  </h1>
  <h2 style="font-size:1.5rem;font-weight:700;color:#6B7280;margin-bottom:20px;">
    <%= message %>
  </h2>
  <p style="font-size:0.95rem;color:#9CA3AF;margin-bottom:30px;line-height:1.6;">
    Désolé, quelque chose s'est mal passé. Veuillez vérifier votre requête ou contacter l'administrateur.
  </p>
  <a href="/" style="display:inline-block;padding:12px 28px;background:#FFCD00;color:#2C2C2C;text-decoration:none;border-radius:10px;font-weight:800;cursor:pointer;transition:all 0.18s;"
     onmouseover="this.style.background='#F5C200'; this.style.transform='translateY(-1px)'; this.style.boxShadow='0 4px 16px rgba(255,205,0,0.45)';"
     onmouseout="this.style.background='#FFCD00'; this.style.transform='translateY(0)'; this.style.boxShadow='none';">
    🏠 Retour à l'accueil
  </a>
  <% if (process.env.NODE_ENV === 'development' && error) { %>
    <div style="margin-top:40px;padding:20px;background:#FFF1F2;border-left:4px solid #EF4444;border-radius:8px;text-align:left;">
      <p style="font-size:0.8rem;color:#991B1B;margin:0;"><strong>Détails (dev):</strong> <%= error.message %></p>
    </div>
  <% } %>
</div>

</body>
</html>
