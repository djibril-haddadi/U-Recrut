<%- include('../layout') %>

<div style="max-width:1300px;margin:0 auto;padding:32px 24px;">
  <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin-bottom:24px;">
    📋 <%= title || 'Toutes les offres d\'emploi' %>
  </h1>

  <% if (message) { %>
    <div style="margin-bottom:20px; padding:16px 20px; border-radius:8px; font-weight:600; display:flex; justify-content:space-between; align-items:center;
      <%= messageType === 'success' ? 'background:#ECFDF5; border:1px solid #DBEAFE; color:#065F46;' : 'background:#FEF3C7; border:1px solid #FBBF24; color:#92400E;' %>">
      <span><%= message %></span>
      <button onclick="this.parentElement.style.display='none';" style="background:none; border:none; font-size:1.5rem; cursor:pointer; opacity:0.7;">✕</button>
    </div>
  <% } %>
  
  <% if (offres.length === 0) { %>
    <div style="background:#fff; border-radius:12px; border:1px dashed #EAECEF; padding:60px 40px; text-align:center;">
      <p style="color:#9CA3AF; font-size:1.1rem; margin-bottom:20px;">Aucune offre disponible pour le moment</p>
      <a href="/" style="display:inline-block; padding:11px 26px; background:#FFCD00; color:#2C2C2C; text-decoration:none; border-radius:10px; font-weight:700; transition:all 0.18s;"
         onmouseover="this.style.background='#F5C200';"
         onmouseout="this.style.background='#FFCD00';">
        Retour à l'accueil
      </a>
    </div>
  <% } else { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));gap:20px">
      <% offres.forEach(offre => { %>
        <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; box-shadow:0 2px 12px rgba(0,0,0,0.05); transition:all 0.2s; cursor:pointer; padding:24px; display:flex; flex-direction:column; justify-content:space-between; min-height:420px;" 
             onmouseover="this.style.boxShadow='0 8px 28px rgba(0,0,0,0.10)'; this.style.transform='translateY(-2px)'; this.style.borderColor='#FFE57A';"
             onmouseout="this.style.boxShadow='0 2px 12px rgba(0,0,0,0.05)'; this.style.transform='translateY(0)'; this.style.borderColor='#EAECEF';">
          
          <div style="display:flex; flex-direction:column; gap:16px; flex:1">
            <div style="margin-bottom:16px;">
              <h3 style="font-size:1.1rem; font-weight:800; color:#2C2C2C; margin-bottom:8px;">
                <%= offre.fiche?.intitule || 'Offre' %>
              </h3>
              <p style="font-size:0.85rem; color:#6B7280;">
                <strong>📍 <%= offre.organisation?.nom || 'Entreprise' %></strong>
              </p>
              <p style="font-size:0.82rem; color:#9CA3AF;">
                📍 <%= offre.fiche?.lieuMission || 'Localisation' %>
              </p>
            </div>

            <div style="margin-bottom:16px; padding:12px; background:#FFFBEB; border-radius:8px;">
              <p style="font-size:0.75rem; color:#92400E; margin-bottom:4px;"><strong>🏷 Type</strong></p>
              <p style="font-size:0.85rem; color:#D4A800;"><%= offre.fiche?.typeMetier || 'N/A' %></p>
            </div>

            <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
            <% if (offre.fiche?.rythme) { %>
              <span style="font-size:0.72rem; font-weight:600; padding:4px 10px; border-radius:99px; background:#EFF6FF; color:#1E40AF;">
                🕐 <%= offre.fiche.rythme %>
              </span>
            <% } %>
            <% if (offre.fiche?.fourchetteSalaire) { %>
              <span style="font-size:0.72rem; font-weight:600; padding:4px 10px; border-radius:99px; background:#ECFDF5; color:#065F46;">
                💰 <%= offre.fiche.fourchetteSalaire %>
              </span>
            <% } %>
            </div>
          </div>

          <p style="font-size:0.82rem; color:#4D4D4D; line-height:1.6; margin-bottom:16px;">
            <%= offre.fiche?.missionsActivites?.substring(0, 100) || 'Description disponible au détail' %>...
          </p>

          <div style="display:flex; gap:8px;">
            <a href="/offres/<%= offre.idOffre %>" style="flex:1; display:block; padding:10px 14px; background:#FFCD00; color:#2C2C2C; text-decoration:none; border-radius:8px; font-size:0.8rem; font-weight:700; cursor:pointer; transition:all 0.18s; border:none; text-align:center;"
               onmouseover="this.style.background='#F5C200';"
               onmouseout="this.style.background='#FFCD00';">
              Voir détail
            </a>
            <% if (user && user.role === 'candidat') { %>
              <a href="/candidatures/create/<%= offre.idOffre %>" style="flex:1; display:inline-flex; justify-content:center; padding:10px 14px; background:#FFCD00; color:#2C2C2C; text-decoration:none; border-radius:8px; font-size:0.8rem; font-weight:700; cursor:pointer; transition:all 0.18s; font-family:'Outfit';"
                 onmouseover="this.style.background='#F5C200';"
                 onmouseout="this.style.background='#FFCD00';">
                Postuler
              </a>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

</body>
</html>
