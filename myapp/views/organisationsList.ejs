<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.6.1/css/bootstrap.min.css" crossorigin="anonymous">
  </head>
  <body class="p-4">
    <div class="container">
      <h1 class="mb-4"><%= title %></h1>
      <table class="table table-bordered table-striped">
        <thead class="thead-dark">
          <tr>
            <th>SIREN</th>
            <th>Nom</th>
            <th>Adresse</th>
          </tr>
        </thead>
        <tbody>
          <% organisations.forEach((org) => { %>
            <tr>
              <td><%= org.siren %></td>
              <td><%= org.nom || org.raison_sociale || '-' %></td>
              <td><%= org.adresse || '-' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </body>
</html>