@startuml
title Application de Recrutement - Authentification & Vue d'ensemble
left to right direction
skinparam actorStyle awesome

actor "Visiteur" as V
actor "Utilisateur" as U
actor "Candidat" as C
actor "Recruteur" as R
actor "Administrateur" as A

V <|-- U
U <|-- C
U <|-- R
U <|-- A

rectangle "Système d'Authentification" {
    usecase "Créer un compte" as UC_REG
    usecase "Se connecter" as UC_LOGIN
    usecase "Se déconnecter" as UC_LOGOUT
}

V --> UC_REG
U --> UC_LOGIN
U --> UC_LOGOUT

note right of U : L'utilisateur connecté accède\naux fonctionnalités spécifiques\nselon son rôle (C, R, A).
@enduml