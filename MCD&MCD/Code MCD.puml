@startuml
hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 10
skinparam shadowing false

class Utilisateur {
  - idUtilisateur : int
  - nom : String
  - prenom : String
  - email : String
  - motDePasseHash : String
  - telephone : String
  - adresse : String
  - codePostal : String
  - ville : String
  - dateCreation : DateTime
  - statutCompte : String
  --
  + creerCompte()
  + sAuthentifier()
  + seDeconnecter()
  + modifierProfil()
}

class Candidat {
  --
  + consulterOffres()
  + postuler(offre : OffreEmploi)
  + soumettreDemandeOrganisation()
  + soumettreDemandeRecruteur()
  + suivreCandidatures()
}

class Recruteur {
  --
  + creerOffre()
  + modifierOffre()
  + publierOffre()
  + consulterCandidatures()
  + traiterCandidature()
}

class Administrateur {
  --
  + validerDemandeOrganisation()
  + refuserDemandeOrganisation()
  + validerDemandeRecruteur()
  + refuserDemandeRecruteur()
  + gererUtilisateurs()
}

class Organisation {
  - siren : String
  - nom : String
  - type : String
  - siegeSocial : String
  --
  + creerOrganisation()
  + modifierOrganisation()
}

class DemandeOrganisation {
  - idDemandeOrganisation : int
  - sirenPropose : String
  - nomPropose : String
  - typePropose : String
  - siegePropose : String
  - dateDemande : Date
  - statutDemande : String
  --
  + soumettre()
  + annuler()
  + changerStatut(statut : String)
}

class DemandeRecruteur {
  - idDemandeRecruteur : int
  - dateDemande : Date
  - statutDemande : String
  --
  + soumettre()
  + annuler()
  + changerStatut(statut : String)
}

class FichePoste {
  - idFichePoste : int
  - intitule : String
  - statutPoste : String
  - responsableHierarchique : String
  - typeMetier : String
  - lieuMission : String
  - rythme : String
  - fourchetteSalaire : String
  - missionsActivites : String
  - competencesAttendues : String
  --
  + creerFiche()
  + modifierFiche()
}

class OffreEmploi {
  - idOffre : int
  - dateCreation : Date
  - datePublication : Date
  - dateValidite : Date
  - statutOffre : String
  - piecesDemandees : String
  - nbPiecesDemandees : int
  --
  + creerOffre()
  + publier()
  + modifier()
  + cloturer()
}

class Candidature {
  - idCandidature : int
  - dateCandidature : Date
  - etatCandidature : String
  --
  + soumettre()
  + retirer()
  + changerEtat(etat : String)
}

class DocumentCandidature {
  - idDocument : int
  - nomFichier : String
  - typeDocument : String
  - cheminStockage : String
  - dateDepot : Date
  --
  + televerser()
  + supprimer()
}

Utilisateur <|-- Candidat
Utilisateur <|-- Recruteur
Utilisateur <|-- Administrateur

Candidat "1" -- "0..*" Candidature : depose
OffreEmploi "1" -- "0..*" Candidature : recoit

Candidature "1" -- "0..*" DocumentCandidature : contient

Organisation "1" -- "0..*" OffreEmploi : publie
Organisation "1" -- "0..*" FichePoste : possede
Recruteur "1" -- "0..*" OffreEmploi : cree / gere
OffreEmploi "0..*" -- "1" FichePoste : repose sur

Recruteur "0..*" -- "1" Organisation : est rattache a

Candidat "1" -- "0..*" DemandeOrganisation : soumet
Candidat "1" -- "0..*" DemandeRecruteur : soumet

Organisation "1" -- "0..*" DemandeRecruteur : est visee par
Administrateur "0..1" -- "0..*" DemandeOrganisation : traite
Administrateur "0..1" -- "0..*" DemandeRecruteur : traite

DemandeOrganisation "0..1" -- "1" Organisation : cree si validee

note left of Candidat
Par defaut, tout nouvel utilisateur
a le role et les fonctionnalites Candidat.
end note

note right of Recruteur
Le role Recruteur donne des
fonctionnalites differentes
de celles du Candidat.
end note

note right of Administrateur
L'administrateur n'a acces
qu'aux fonctions d'administration.
Pas aux fonctions candidat/recruteur.
end note

note top of Administrateur
Un compte administrateur est cree
par defaut au demarrage de l'application.
end note

note top of Utilisateur
Specialisation exclusive :
un utilisateur est soit Candidat,
soit Recruteur, soit Administrateur.
Les attributs adresse / codePostal / ville
permettent notamment le tri par distance.
end note

note right of OffreEmploi
statutOffre :
non publiee / publiee / expiree
end note

note bottom of Candidature
Contrainte :
un candidat ne peut pas candidater
deux fois a la meme offre.
Unicite sur (Candidat, OffreEmploi)
end note

note bottom of Utilisateur
Notifications par mail envoyees lors :
- creation du compte
- validation d'une demande d'organisation
- validation d'une demande recruteur
- attribution des droits administrateur
end note

@enduml