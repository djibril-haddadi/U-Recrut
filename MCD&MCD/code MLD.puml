@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 10

entity "Utilisateur" as utilisateur {
  idUtilisateur : int [PK]
  nom : varchar
  prenom : varchar
  email : varchar [UK]
  motDePasseHash : varchar
  telephone : varchar
  adresse : varchar
  codePostal : varchar
  ville : varchar
  dateCreation : datetime
  statutCompte : varchar
}

entity "Candidat" as candidat {
  idCandidat : int [PK] [FK]
}

entity "Recruteur" as recruteur {
  idRecruteur : int [PK] [FK]
  sirenOrganisation : varchar [FK]
}

entity "Administrateur" as administrateur {
  idAdministrateur : int [PK] [FK]
}

entity "DemandeOrganisation" as demande_organisation {
  idDemandeOrganisation : int [PK]
  sirenPropose : varchar
  nomPropose : varchar
  typePropose : varchar
  siegePropose : varchar
  dateDemande : date
  statutDemande : varchar
  idCandidat : int [FK]
  idAdministrateur : int [FK]
}

entity "Organisation" as organisation {
  siren : varchar [PK]
  nom : varchar
  type : varchar
  siegeSocial : varchar
  idDemandeOrganisationSource : int [FK] [UK]
}

entity "DemandeRecruteur" as demande_recruteur {
  idDemandeRecruteur : int [PK]
  dateDemande : date
  statutDemande : varchar
  idCandidat : int [FK]
  sirenOrganisation : varchar [FK]
  idAdministrateur : int [FK]
}

entity "FichePoste" as fiche_poste {
  idFichePoste : int [PK]
  intitule : varchar
  statutPoste : varchar
  responsableHierarchique : varchar
  typeMetier : varchar
  lieuMission : varchar
  rythme : varchar
  fourchetteSalaire : varchar
  missionsActivites : text
  competencesAttendues : text
  sirenOrganisation : varchar [FK]
}

entity "OffreEmploi" as offre_emploi {
  idOffre : int [PK]
  dateCreation : date
  datePublication : date
  dateValidite : date
  statutOffre : varchar
  piecesDemandees : text
  nbPiecesDemandees : int
  sirenOrganisation : varchar [FK]
  idRecruteur : int [FK]
  idFichePoste : int [FK]
}

entity "Candidature" as candidature {
  idCandidature : int [PK]
  dateCandidature : date
  etatCandidature : varchar
  idCandidat : int [FK]
  idOffre : int [FK]
}

entity "DocumentCandidature" as document_candidature {
  idDocument : int [PK]
  nomFichier : varchar
  typeDocument : varchar
  cheminStockage : varchar
  dateDepot : date
  idCandidature : int [FK]
}

utilisateur ||--o| candidat : a_pour_role
utilisateur ||--o| recruteur : a_pour_role
utilisateur ||--o| administrateur : a_pour_role

candidat ||--o{ demande_organisation : soumet
administrateur |o--o{ demande_organisation : traite
demande_organisation ||--o| organisation : cree_si_validee

candidat ||--o{ demande_recruteur : soumet
organisation ||--o{ demande_recruteur : est_visee_par
administrateur |o--o{ demande_recruteur : traite

organisation ||--o{ fiche_poste : possede
fiche_poste ||--o{ offre_emploi : repose_sur
organisation ||--o{ recruteur : rattache
organisation ||--o{ offre_emploi : publie
recruteur ||--o{ offre_emploi : cree

candidat ||--o{ candidature : depose
offre_emploi ||--o{ candidature : recoit
candidature ||--o{ document_candidature : contient

note top of utilisateur
Contrainte metier :
un utilisateur possede un seul role actif
parmi candidat, recruteur, administrateur.
Les attributs adresse / codePostal / ville
permettent notamment le tri par distance.
end note

note right of demande_organisation
idAdministrateur nullable :
la demande peut ne pas encore
etre traitee.
end note

note right of demande_recruteur
idAdministrateur nullable :
la demande peut ne pas encore
etre traitee.
end note

note bottom of candidature
UNIQUE(idCandidat, idOffre)
end note

@enduml