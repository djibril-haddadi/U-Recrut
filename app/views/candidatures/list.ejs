<%- include('../layout') %>

<div style="display:flex; min-height:calc(100vh - 60px);">
  <!-- Sidebar -->
  <nav style="width:220px; flex-shrink:0; background:#fff; border-right:1px solid #EAECEF; padding:20px 0; display:flex; flex-direction:column;">
    <div style="padding:16px 20px; border-bottom:1px solid #EAECEF; margin-bottom:10px;">
      <p style="font-size:0.75rem; color:#9CA3AF; text-transform:uppercase; letter-spacing:1.5px; font-weight:600; margin:0;">Dashboard Candidat</p>
    </div>
    
    <a href="/dashboard/candidat" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>📊</span>Tableau de bord
    </a>
    <a href="/candidatures" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:700; color:#2C2C2C; border-left:3px solid #FFCD00; background:#FFFBEB; text-decoration:none;">
      <span>📋</span>Mes candidatures
    </a>
    
    <div style="margin-top:auto; padding:16px 20px; border-top:1px solid #EAECEF;">
      <a href="/auth/logout" style="display:block; padding:10px 14px; background:transparent; color:#9F1239; border:1.5px solid #FFF1F2; border-radius:8px; font-size:0.8rem; font-weight:600; cursor:pointer; text-align:center; text-decoration:none; transition:all 0.15s;"
         onmouseover="this.style.background='#FFF1F2';"
         onmouseout="this.style.background='transparent';">
        🚪 Déconnexion
      </a>
    </div>
  </nav>

  <!-- Main -->
  <main style="flex:1; padding:30px; overflow-y:auto; background:#F8F9FA;">
    <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin-bottom:30px;">
      📝 Mes candidatures
    </h1>

    <% if (candidatures.length === 0) { %>
    <div style="background:#fff; border-radius:12px; border:1px dashed #EAECEF; padding:60px 40px; text-align:center;">
      <p style="color:#9CA3AF; font-size:1.1rem; margin-bottom:20px;">Vous n'avez postulé à aucune offre pour le moment</p>
      <a href="/offres" style="display:inline-block; padding:11px 26px; background:#FFCD00; color:#2C2C2C; text-decoration:none; border-radius:10px; font-weight:700; transition:all 0.18s;"
         onmouseover="this.style.background='#F5C200';"
         onmouseout="this.style.background='#FFCD00';">
        Consulter les offres
      </a>
    </div>
  <% } else { %>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(340px, 1fr)); gap:20px;">
      <% candidatures.forEach(cand => { %>
        <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.04); transition:all 0.2s;"
             onmouseover="this.style.boxShadow='0 8px 20px rgba(0,0,0,0.10)'; this.style.transform='translateY(-2px)';"
             onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)'; this.style.transform='translateY(0)';">
          
          <!-- Status badge -->
          <div style="background:<% 
            if (cand.etatCandidature === 'en attente') { %>transparent; <% }
            else if (cand.etatCandidature === 'entretien') { %>rgba(59, 130, 246, 0.1); <% }
            else if (cand.etatCandidature === 'acceptée') { %>rgba(16, 185, 129, 0.1); <% }
            else if (cand.etatCandidature === 'rejetée') { %>rgba(239, 68, 68, 0.1); <% } %>
            padding:12px 16px; border-bottom:1px solid #EAECEF;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <h3 style="font-size:1rem; font-weight:800; color:#2C2C2C; margin:0;">
                <%= cand.fiche?.intitule || 'Offre' %>
              </h3>
              <span style="display:inline-flex; align-items:center; gap:5px; padding:4px 11px; border-radius:99px; font-size:0.75rem; font-weight:700;
                background:<% 
                  if (cand.etatCandidature === 'en attente') { %>rgba(245, 158, 11, 0.15); color:#92400E; <% }
                  else if (cand.etatCandidature === 'entretien') { %>rgba(30, 64, 175, 0.15); color:#1E40AF; <% }
                  else if (cand.etatCandidature === 'acceptée') { %>rgba(16, 185, 129, 0.15); color:#065F46; <% }
                  else if (cand.etatCandidature === 'rejetée') { %>rgba(239, 68, 68, 0.15); color:#991B1B; <% } %>">
                <% if (cand.etatCandidature === 'en attente') { %>⏳ <% }
                   else if (cand.etatCandidature === 'entretien') { %>📞 <% }
                   else if (cand.etatCandidature === 'acceptée') { %>✅ <% }
                   else if (cand.etatCandidature === 'rejetée') { %>❌ <% } %>
                <%= cand.etatCandidature.charAt(0).toUpperCase() + cand.etatCandidature.slice(1) %>
              </span>
            </div>
          </div>

          <!-- Content -->
          <div style="padding:16px;">
            <p style="font-size:0.8rem; color:#6B7280; margin-bottom:12px;">
              📍 <%= cand.fiche?.lieuMission || 'Localisation' %>
            </p>
            <p style="font-size:0.8rem; color:#9CA3AF; margin-bottom:12px;">
              📅 Postulé le <%= new Date(cand.dateCandidature).toLocaleDateString('fr-FR') %>
            </p>
            <div style="padding:12px; background:#FFFBEB; border-radius:8px; margin-bottom:12px;">
              <p style="font-size:0.72rem; color:#92400E; text-transform:uppercase; letter-spacing:1px; font-weight:600; margin-bottom:4px;">Rythme</p>
              <p style="font-size:0.85rem; color:#D4A800;"><%= cand.fiche?.rythme || 'Non spécifié' %></p>
            </div>
            <a href="/offres/<%= cand.offre.idOffre %>" style="display:block; padding:10px 14px; background:#FFCD00; color:#2C2C2C; text-decoration:none; border-radius:8px; font-size:0.8rem; font-weight:700; cursor:pointer; transition:all 0.18s; border:none; text-align:center;"
               onmouseover="this.style.background='#F5C200';"
               onmouseout="this.style.background='#FFCD00';">
              Voir l'offre
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
  </main>
</div>

</body>
</html>
