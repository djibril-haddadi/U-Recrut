<%- include('../layout') %>

<div style="max-width:680px; margin:0 auto; padding:40px 24px;">
  <a href="/offres/<%= idOffre %>" style="color:#FFCD00; text-decoration:none; font-weight:700; margin-bottom:20px; display:inline-block;">← Retour à l'offre</a>

  <div style="background:#fff; border-radius:18px; padding:36px; box-shadow:0 10px 30px rgba(0,0,0,0.06);">
    <h1 style="font-size:1.8rem; font-weight:900; color:#2C2C2C; margin-bottom:18px;">Postuler à l'offre</h1>
    <p style="color:#6B7280; font-size:0.95rem; margin-bottom:24px;">Téléversez votre document de candidature pour compléter votre inscription.</p>

    <form action="/candidatures/create/<%= idOffre %>" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom:20px;">
        <label style="display:block; font-size:0.85rem; font-weight:700; color:#3A3A3A; margin-bottom:10px;">Fichier de candidature</label>
        <input type="file" name="document" accept="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required style="width:100%; padding:12px; border:1.5px solid #D1D5DB; border-radius:12px; font-size:0.95rem; background:#F9FAFB;" />
      </div>

      <button type="submit" style="width:100%; padding:14px; background:#FFCD00; color:#2C2C2C; border:none; border-radius:12px; font-size:0.95rem; font-weight:800; cursor:pointer;">Envoyer ma candidature</button>
    </form>
  </div>
</div>

</body>
</html>
