<%- include('../layout') %>

<div style="display:flex;min-height:calc(100vh - 60px);">
  <!-- Left panel -->
  <div style="width:48%; background:linear-gradient(150deg, #2C2C2C 0%, #4D4D4D 100%); display:flex; flex-direction:column; align-items:flex-start; justify-content:center; padding:64px 60px; position:relative; overflow:hidden;">
    <div style="position:absolute; bottom:-100px; right:-80px; width:350px; height:350px; border-radius:50%; border:80px solid rgba(255,205,0,0.08);"></div>
    
    <div style="font-size:0.75rem;color:rgba(255,205,0,0.8);text-transform:uppercase;letter-spacing:2px;font-weight:700;margin-bottom:20px;">U-Recrut — Votre espace personnel</div>
    <h2 style="font-size:2rem;font-weight:900;color:#fff;line-height:1.2;margin-bottom:14px;">Connectez-vous<br>dès maintenant</h2>
    <p style="color:rgba(255,255,255,0.6);font-size:0.9rem;line-height:1.65;margin-bottom:36px;">Accédez à votre espace personnel pour gérer vos offres, candidatures et bien plus.</p>
    
    <div style="position:relative; z-index:1;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:18px;">
        <div style="width:38px; height:38px; border-radius:10px; background:rgba(255,205,0,0.15); border:1px solid rgba(255,205,0,0.25); display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0;">📋</div>
        <span style="font-size:0.87rem; color:rgba(255,255,255,0.8);">Gérez vos candidatures facilement</span>
      </div>
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:18px;">
        <div style="width:38px; height:38px; border-radius:10px; background:rgba(255,205,0,0.15); border:1px solid rgba(255,205,0,0.25); display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0;">🎯</div>
        <span style="font-size:0.87rem; color:rgba(255,255,255,0.8);">Trouvez les meilleures opportunités</span>
      </div>
      <div style="display:flex; align-items:center; gap:12px;">
        <div style="width:38px; height:38px; border-radius:10px; background:rgba(255,205,0,0.15); border:1px solid rgba(255,205,0,0.25); display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0;">👥</div>
        <span style="font-size:0.87rem; color:rgba(255,255,255,0.8);">Connectez-vous avec les recruteurs</span>
      </div>
    </div>
  </div>

  <!-- Right form panel -->
  <div style="flex:1; display:flex; align-items:center; justify-content:center; padding:40px; background:#F8F9FA;">
    <div style="background:#fff; border-radius:18px; padding:44px 40px; width:100%; max-width:420px; box-shadow:0 4px 30px rgba(0,0,0,0.08); border:1px solid #EAECEF;">
      <h1 style="font-size:1.5rem; font-weight:900; color:#2C2C2C; margin-bottom:24px;">Connexion</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background:#FFF1F2; border:1.5px solid #FFE4E6; border-radius:12px; padding:14px 18px; margin-bottom:20px; color:#9F1239; font-size:0.85rem;">
          ❌ <%= error %>
        </div>
      <% } %>
      <% if (typeof message !== 'undefined' && message) { %>
        <div style="background:#ECFDF5; border:1.5px solid #D1FAE5; border-radius:12px; padding:14px 18px; margin-bottom:20px; color:#065F46; font-size:0.85rem;">
          ✅ <%= message %>
        </div>
      <% } %>

      <form method="POST" action="/auth/login">
        <div style="margin-bottom:18px;">
          <label style="display:block; font-size:0.82rem; font-weight:700; color:#3A3A3A; margin-bottom:6px;">Email</label>
          <input type="email" name="email" required style="width:100%; padding:11px 14px; border:1.5px solid #D1D5DB; border-radius:10px; font-size:0.9rem; font-family:'Outfit'; color:#2C2C2C; outline:none; transition:border 0.18s; background:#fff;"
                 onfocus="this.style.borderColor='#FFCD00'; this.style.boxShadow='0 0 0 3px rgba(255,205,0,0.12)';"
                 onblur="this.style.borderColor='#D1D5DB'; this.style.boxShadow='none';">
        </div>

        <div style="margin-bottom:22px;">
          <label style="display:block; font-size:0.82rem; font-weight:700; color:#3A3A3A; margin-bottom:6px;">Mot de passe</label>
          <input type="password" name="password" required style="width:100%; padding:11px 14px; border:1.5px solid #D1D5DB; border-radius:10px; font-size:0.9rem; font-family:'Outfit'; color:#2C2C2C; outline:none; transition:border 0.18s; background:#fff;"
                 onfocus="this.style.borderColor='#FFCD00'; this.style.boxShadow='0 0 0 3px rgba(255,205,0,0.12)';"
                 onblur="this.style.borderColor='#D1D5DB'; this.style.boxShadow='none';">
        </div>

        <button type="submit" style="width:100%; padding:13px; background:#FFCD00; color:#2C2C2C; border:none; border-radius:10px; font-family:'Outfit'; font-weight:800; font-size:0.95rem; cursor:pointer; transition:all 0.18s; letter-spacing:0.2px;"
                onmouseover="this.style.background='#F5C200'; this.style.boxShadow='0 4px 18px rgba(255,205,0,0.45)';"
                onmouseout="this.style.background='#FFCD00'; this.style.boxShadow='none';">
          Se connecter
        </button>
      </form>

      <div style="margin-top:20px; padding-top:20px; border-top:1px solid #EAECEF; text-align:center;">
        <p style="font-size:0.85rem; color:#6B7280; margin-bottom:8px;">Pas encore de compte ?</p>
        <a href="/auth/register" style="color:#FFCD00; text-decoration:none; font-weight:700; cursor:pointer;">
          Créer un compte →
        </a>
      </div>
    </div>
  </div>
</div>

</body>
</html>
