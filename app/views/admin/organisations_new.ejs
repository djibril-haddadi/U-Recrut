<%- include('../layout') %>

<div style="display:flex; min-height:calc(100vh - 60px);">
  <nav style="width:220px; flex-shrink:0; background:#fff; border-right:1px solid #EAECEF; padding:20px 0; display:flex; flex-direction:column;">
    <div style="padding:16px 20px; border-bottom:1px solid #EAECEF; margin-bottom:10px;">
      <p style="font-size:0.75rem; color:#9CA3AF; text-transform:uppercase; letter-spacing:1.5px; font-weight:600; margin:0;">Console Admin</p>
    </div>
    <a href="/dashboard/admin" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; text-decoration:none;">← Retour à la console</a>
  </nav>

  <main style="flex:1; padding:30px; overflow-y:auto; background:#F8F9FA;">
    <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin-bottom:24px;">Ajouter une organisation</h1>

    <div style="background:#fff; border-radius:18px; padding:30px; box-shadow:0 10px 30px rgba(0,0,0,0.05);">
      <form method="POST" action="/admin/organisations">
        <div style="margin-bottom:18px;">
          <label style="display:block; font-weight:700; color:#3A3A3A; margin-bottom:8px;">SIREN</label>
          <input type="text" name="siren" required style="width:100%; padding:12px; border:1.5px solid #D1D5DB; border-radius:12px;" />
        </div>
        <div style="margin-bottom:18px;">
          <label style="display:block; font-weight:700; color:#3A3A3A; margin-bottom:8px;">Nom de l'organisation</label>
          <input type="text" name="nom" required style="width:100%; padding:12px; border:1.5px solid #D1D5DB; border-radius:12px;" />
        </div>
        <div style="margin-bottom:18px;">
          <label style="display:block; font-weight:700; color:#3A3A3A; margin-bottom:8px;">Type</label>
          <input type="text" name="type" style="width:100%; padding:12px; border:1.5px solid #D1D5DB; border-radius:12px;" />
        </div>
        <div style="margin-bottom:24px;">
          <label style="display:block; font-weight:700; color:#3A3A3A; margin-bottom:8px;">Siège social</label>
          <input type="text" name="siegeSocial" style="width:100%; padding:12px; border:1.5px solid #D1D5DB; border-radius:12px;" />
        </div>

        <button type="submit" style="padding:14px 18px; background:#FFCD00; color:#2C2C2C; border:none; border-radius:12px; font-weight:800; cursor:pointer;">Ajouter</button>
      </form>
    </div>
  </main>
</div>

</body>
</html>
