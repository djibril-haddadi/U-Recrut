<%- include('../layout') %>

<div style="display:flex; min-height:calc(100vh - 60px);">
  <!-- Sidebar -->
  <nav style="width:220px; flex-shrink:0; background:#fff; border-right:1px solid #EAECEF; padding:20px 0; display:flex; flex-direction:column;">
    <div style="padding:16px 20px; border-bottom:1px solid #EAECEF; margin-bottom:10px;">
      <p style="font-size:0.75rem; color:#9CA3AF; text-transform:uppercase; letter-spacing:1.5px; font-weight:600; margin:0;">Console Admin</p>
    </div>
    
    <a href="/dashboard/admin" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>⚙️</span>Console principale
    </a>
    <a href="/admin/users" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>👤</span>Utilisateurs
    </a>
    <a href="/admin/organisations" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:700; color:#2C2C2C; border-left:3px solid #FFCD00; background:#FFFBEB; text-decoration:none;">
      <span>🏢</span>Organisations
    </a>
    <a href="/admin/recruteurs" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>👥</span>Recruteurs
    </a>
    <a href="/admin/demandes-recruteurs" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>📬</span>Demandes recruteurs
    </a>
    <a href="/admin/offres" style="display:flex; align-items:center; gap:10px; padding:10px 20px; font-size:0.86rem; font-weight:600; color:#6B7280; border-left:3px solid transparent; text-decoration:none; transition:all 0.15s;"
       onmouseover="this.style.background='#FFFBEB'; this.style.color='#4D4D4D';"
       onmouseout="this.style.background='transparent'; this.style.color='#6B7280';">
      <span>📋</span>Offres
    </a>
    
    <div style="margin-top:auto; padding:16px 20px; border-top:1px solid #EAECEF;">
      <a href="/auth/logout" style="display:block; padding:10px 14px; background:transparent; color:#9F1239; border:1.5px solid #FFF1F2; border-radius:8px; font-size:0.8rem; font-weight:600; cursor:pointer; text-align:center; text-decoration:none; transition:all 0.15s;"
         onmouseover="this.style.background='#FFF1F2';"
         onmouseout="this.style.background='transparent';">
        🚪 Déconnexion
      </a>
    </div>
  </nav>

  <!-- Main -->
  <main style="flex:1; padding:30px; overflow-y:auto; background:#F8F9FA;">
    <a href="/dashboard/admin" style="color:#FFCD00; text-decoration:none; font-weight:700; margin-bottom:20px; display:inline-block;">
      ← Retour à la console
    </a>

    <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:24px;">
      <h1 style="font-size:2rem; font-weight:900; color:#2C2C2C; margin:0;">🏢 Organisations</h1>
      <a href="/admin/organisations/new" style="padding:12px 18px; background:#FFCD00; color:#2C2C2C; border-radius:12px; text-decoration:none; font-weight:800;">Ajouter une organisation</a>
    </div>

  <% if (organisations.length === 0) { %>
    <div style="background:#fff; border-radius:12px; border:1px dashed #EAECEF; padding:60px 40px; text-align:center;">
      <p style="color:#9CA3AF; font-size:1rem;">Aucune organisation enregistrée</p>
    </div>
  <% } else { %>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:16px;">
      <% organisations.forEach(org => { %>
        <div style="background:#fff; border-radius:12px; border:1px solid #EAECEF; box-shadow:0 2px 8px rgba(0,0,0,0.04); padding:20px;">
          <h3 style="font-size:1rem; font-weight:800; color:#2C2C2C; margin-bottom:8px;">
            <%= org.nom %>
          </h3>
          <p style="font-size:0.8rem; color:#6B7280; margin-bottom:8px;">
            <strong>Type:</strong> <%= org.type %>
          </p>
          <p style="font-size:0.8rem; color:#6B7280; margin-bottom:12px;">
            <strong>Siège:</strong> <%= org.siegeSocial %>
          </p>
          <p style="font-size:0.75rem; color:#9CA3AF; padding:8px; background:#FFFBEB; border-radius:6px;">
            <strong>SIREN:</strong> <%= org.siren %>
          </p>
        </div>
      <% }); %>
    </div>
  <% } %>
</main></div>

</body>
</html>
